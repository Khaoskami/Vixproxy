# ==============================================================================
# Vixproxy backend — environment variables
# Copy to .env.local for development, or set in the Railway dashboard.
# ==============================================================================

NODE_ENV=development
PORT=3000

# ---- Database (Supabase Postgres) -------------------------------------------
# Use one of:
#   Direct (IPv6):               postgresql://postgres:PASSWORD@db.REF.supabase.co:5432/postgres
#   Shared pooler — session:     postgres://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#   Shared pooler — transaction: postgres://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# For a persistent Railway backend, prefer Session mode (port 5432 on pooler).
# If you use Transaction mode (port 6543), the client auto-disables prepared
# statements (as required).
DATABASE_URL=

# ---- Supabase Auth / Storage ------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ---- Encryption (AES-256-GCM) -----------------------------------------------
# Generate a 32-byte hex key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=

# Optional: keyring JSON for rotation (overrides MASTER_ENCRYPTION_KEY).
# Highest version wins for NEW encryptions; lower versions remain decryptable.
#   {"1":"<64 hex>","2":"<64 hex>"}
# ENCRYPTION_KEY_RING=

# ---- Upstream provider keys (fallbacks when user has none configured) -------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=

# ---- Safety -----------------------------------------------------------------
# OpenAI Moderation API key (free). If not set, OPENAI_API_KEY is reused.
OPENAI_MODERATION_API_KEY=

# LlamaGuard 4 via OpenAI-compatible endpoint (e.g. Groq, Together, vLLM).
LLAMAGUARD_BASE_URL=
LLAMAGUARD_API_KEY=

# Threshold for OpenAI moderation `sexual/minors` — block at or above this.
# Set aggressively low due to asymmetric harm.
SAFETY_SEXUAL_MINORS_THRESHOLD=0.1

# ---- NCMEC (CyberTipline) ---------------------------------------------------
# Requires ESP registration with NCMEC.
NCMEC_ESP_ID=
NCMEC_API_USERNAME=
NCMEC_API_PASSWORD=
NCMEC_REPORTING_ENABLED=false

# ---- Rate limiting ----------------------------------------------------------
RATE_LIMIT_PER_MIN=60
