# ============================================
# VIXPROXY — Environment Variables
# ============================================
# Copy to .env for local dev. NEVER commit .env.

# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Database (use /app/data/vixproxy.db on Railway with a Volume mounted at /app/data)
DB_PATH=./data/vixproxy.db

# Session secret — generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_ME_64_BYTE_HEX

# AES-256-GCM key for encrypting API keys at rest — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Save this in a password manager. Losing it = all stored keys unrecoverable.
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX

# Rate Limits
LOGIN_RATE_LIMIT_MAX=5
API_RATE_LIMIT_MAX=60
GLOBAL_RATE_LIMIT_MAX=200
